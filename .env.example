APP_NAME=Workio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# ИИ-модуль работает через очередь: без обработчика разбор документов,
# оценки и решения не выполняются. Запускайте `php artisan schedule:work`
# (или cron с `schedule:run` раз в минуту) — см. README.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Почта. С MAIL_MAILER=log письма (сброс пароля и т. п.) не уходят, а пишутся
# в storage/logs/laravel.log — годится только для разработки. Для настоящей
# отправки нужен SMTP-сервер, например:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=null
#   MAIL_USERNAME=адрес@gmail.com
#   MAIL_PASSWORD=пароль приложения (не обычный пароль от почты)
#   MAIL_FROM_ADDRESS=адрес@gmail.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Помощник по составлению резюме (Google AI Studio, бесплатный тариф).
# Без ключа страница помощника показывает подсказку и не ломает обычную форму.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Модель для оценок и разбора документов — глубже, но на бесплатном ключе
# бывает занята; тогда подхватывает запасная
GEMINI_MODEL_SCORING=gemini-3.6-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# Сервер видеовстреч (Jitsi). meet.jit.si требует входа в аккаунт для создания комнаты.
JITSI_DOMAIN=meet.ffmuc.net

# Тренажёр собеседований: не больше стольких тренировок в сутки на пользователя
TRAINER_DAILY_LIMIT=3

# Вход через Google: ключи из Google Cloud Console (OAuth client ID, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
